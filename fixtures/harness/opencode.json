{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "permission": {
    "bash": {
      "git status *": "allow",
      "git diff *": "allow",
      "git push origin *": "allow",
      "pnpm test": "allow",
      "docker compose up *": "ask"
    }
  },
  "autoModeGuard": {
    "environment": {
      "gitRemotes": ["origin"],
      "domains": ["api.trusted.example.com"]
    }
  }
}
